# Meta (una sola app; los WABA de tus clientes se asocian a ella)
META_APP_SECRET=
VERIFY_TOKEN=una-cadena-larga-aleatoria
GRAPH_VERSION=v21.0

# Gemini
GEMINI_API_KEY=

# Supabase (usa la service role key; solo en el servidor, nunca en el cliente)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 32 bytes en base64. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
